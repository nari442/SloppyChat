{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/"
    },
    {
      "source": "/app/(.*)",
      "destination": "/"
    },
    {
      "source": "/:handle([A-Za-z2-7]{12})",
      "destination": "/"
    },
    {
      "source": "/@:handle([A-Za-z2-7]{12})",
      "destination": "/"
    }
  ]
}
